@page
@model HomeBusinessAssistant.Host.Pages.WakeRemote.IndexModel
@using HomeBusinessAssistant.Application.Power
@{
    ViewData["Title"] = "Wake & Remote";
}

<header class="page-header"><div><p class="eyebrow">Windows wake and availability</p><h1>Wake &amp; Remote</h1><p>Inspect the one managed wake task, test wake timing harmlessly, and hold bounded keep-awake sessions.</p></div><div class="page-actions"><form method="post" asp-page-handler="RunDiagnostics"><button class="secondary">Run diagnostics</button></form><form method="post" asp-page-handler="Reconcile"><button class="primary">Reconcile task</button></form></div></header>

@if (Model.Attention is not null) { <p class="empty-state attention-text">@Model.Attention</p> }

<section class="facts-strip" aria-label="Wake status">
    <div class="fact"><span>Managed task</span><strong>@(Model.WakeTask.Exists ? Model.WakeTask.IsManaged ? "Registered" : "Unexpected shape" : "Not required")</strong></div>
    <div class="fact"><span>Next wake</span><strong>@(Model.WakeTask.DueAtUtc?.ToLocalTime().ToString("g") ?? "None")</strong></div>
    <div class="fact"><span>Occurrence</span><strong class="code">@(Model.WakeTask.OccurrenceId?.ToString() ?? "—")</strong></div>
    <div class="fact"><span>Manual keep-awake</span><strong>@(Model.KeepAwake.IsActive ? $"Until {Model.KeepAwake.ExpiresAtUtc?.ToLocalTime():t}" : "Released")</strong></div>
    <div class="fact"><span>Provider</span><strong>@(Model.Agent?.Agent.AttentionReason ?? "No attention")</strong></div>
</section>

<div class="content-grid">
    <div class="stack">
        <section class="panel"><div class="panel-heading"><h2>Harmless wake test</h2></div><p class="supporting">Preparing a test registers a future Runner occurrence. It does not suspend, hibernate, shut down, or change permanent power settings.</p><div class="inline-actions"><form method="post" asp-page-handler="PrepareWakeTest" data-confirm="Prepare a wake test 3 minutes from now? You must put the computer to sleep manually if you want to test physical wake."><input type="hidden" name="minutes" value="3" /><button class="secondary">Test in 3 min</button></form><form method="post" asp-page-handler="PrepareWakeTest" data-confirm="Prepare a wake test 5 minutes from now? You must put the computer to sleep manually if you want to test physical wake."><input type="hidden" name="minutes" value="5" /><button class="secondary">Test in 5 min</button></form><form method="post" asp-page-handler="PrepareWakeTest"><label for="wake-minutes">Custom minutes</label><input id="wake-minutes" name="minutes" type="number" min="3" max="1440" value="10" /><button class="ghost">Prepare</button></form></div><ol class="detail-list"><li>Save work and prepare the test.</li><li>Confirm the due time and managed task shown above.</li><li>Optionally put Windows to sleep yourself.</li><li>After resuming, inspect the Wake Remote run timeline and wake-delay metric.</li></ol></section>
        <section class="panel"><div class="panel-heading"><h2>Manual keep-awake</h2><span class="pill @(Model.KeepAwake.IsActive ? "positive" : "muted")">@(Model.KeepAwake.IsActive ? "Active" : "Inactive")</span></div><p class="supporting">The Host keeps only the system awake, never forces the display on, and never forces sleep afterward.</p><div class="inline-actions"><form method="post" asp-page-handler="KeepAwake" data-confirm="Keep this system awake for 30 minutes?"><input type="hidden" name="minutes" value="30" /><button class="secondary">30 minutes</button></form><form method="post" asp-page-handler="KeepAwake" data-confirm="Keep this system awake for 60 minutes?"><input type="hidden" name="minutes" value="60" /><button class="secondary">60 minutes</button></form><form method="post" asp-page-handler="KeepAwake"><label for="keep-minutes">Custom minutes</label><input id="keep-minutes" name="minutes" type="number" min="1" max="1440" value="120" /><button class="ghost">Start / extend</button></form>@if (Model.KeepAwake.IsActive) { <form method="post" asp-page-handler="ReleaseKeepAwake" data-confirm="Release the manual keep-awake request now?"><button class="danger">Release</button></form> }</div></section>
        <section class="table-shell"><div class="panel panel-heading"><h2>Availability schedules</h2><a asp-page="/Schedules/Edit" asp-route-agentId="wake-remote">Create</a></div>@if (Model.Agent?.Schedules.Count is null or 0) { <p class="empty-state">No Wake Remote schedules exist.</p> } else { <div class="table-scroll"><table><thead><tr><th>Name</th><th>Type</th><th>State</th><th>Wake</th></tr></thead><tbody>@foreach (var schedule in Model.Agent.Schedules) { <tr><td><a asp-page="/Schedules/Details" asp-route-id="@schedule.Id">@schedule.Name</a></td><td>@schedule.Kind</td><td>@(schedule.IsEnabled ? schedule.IsPaused ? "Paused" : "Enabled" : "Disabled")</td><td>@schedule.WakePolicy</td></tr> }</tbody></table></div> }</section>
    </div>
    <aside class="stack">
        <section class="panel"><div class="panel-heading"><h2>Windows diagnostics</h2></div>@if (Model.Diagnostics is null) { <p class="empty-state">Diagnostics unavailable.</p> } else { <ul class="detail-list"><li><strong>Sleep states</strong><span class="supporting">@(Model.Diagnostics.SleepStatesQuerySucceeded ? "Query succeeded" : "Unavailable")</span></li><li><strong>Wake timers</strong><span class="supporting">@(Model.Diagnostics.HasReportedWakeTimer ? "Reported" : "None reported")</span></li><li><strong>Wake-armed devices</strong><span class="supporting">@(Model.Diagnostics.HasArmedWakeDevice ? "Present" : "None reported")</span></li><li><strong>Captured</strong><span class="supporting">@Model.Diagnostics.CapturedAtUtc.ToLocalTime().ToString("g")</span></li></ul> }</section>
        @if (Model.Diagnostics is not null) { @foreach (PowerDiagnosticResult result in Model.Diagnostics.Results) { <section class="panel"><div class="panel-heading"><h2>@result.Kind</h2><span class="pill @(result.ExitCode == 0 && !result.TimedOut ? "positive" : "attention")">@(result.TimedOut ? "Timed out" : $"Exit {result.ExitCode}")</span></div><pre>@(string.IsNullOrWhiteSpace(result.Output) ? result.Error : result.Output)</pre></section> } }
        <section class="panel"><div class="panel-heading"><h2>Configuration</h2></div><div class="inline-actions"><a class="button-link ghost" asp-page="/Agents/Configuration" asp-route-id="wake-remote">Edit settings</a><a class="button-link ghost" asp-page="/Runs/Index" asp-route-agentId="wake-remote">View runs</a></div></section>
    </aside>
</div>
