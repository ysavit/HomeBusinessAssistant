@page "{id:guid}"
@model HomeBusinessAssistant.Host.Pages.FounderScout.Candidates.DetailsModel
@using System.Text.Json
@using global::FounderScout.Domain
@{
    ViewData["Title"] = Model.Detail?.Candidate.DisplayName ?? "Candidate";
    var detail = Model.Detail!;
    var latestEvaluation = detail.Evaluations.FirstOrDefault();
    var generatedDraft = detail.Drafts.FirstOrDefault(draft => !draft.Superseded);
    var activeRevision = generatedDraft is null ? null : detail.DraftRevisions.FirstOrDefault(revision => revision.SourceDraftId == generatedDraft.Id && revision.IsActive);
}

<header class="page-header"><div><p class="eyebrow">Evidence-led founder review</p><h1>@detail.Candidate.DisplayName</h1><p>@detail.Summary</p></div><div class="page-actions"><a class="button-link ghost" asp-page="/FounderScout/Candidates/Index">Back to candidates</a>@if (Uri.TryCreate(detail.Candidate.CanonicalSourceUrl, UriKind.Absolute, out var source) && (source.Scheme == Uri.UriSchemeHttps || source.Scheme == Uri.UriSchemeHttp && source.IsLoopback)) { <a class="button-link secondary" href="@source.AbsoluteUri" target="_blank" rel="noopener noreferrer">Open source profile</a> }</div></header>
<partial name="../_Tabs" />

<section class="manual-notice"><strong>No-send workspace</strong><span>Copy a reviewed draft and send it manually in the source product. Founder Scout cannot transmit invitations.</span></section>
@if (latestEvaluation is null)
{
    <section class="manual-notice ai-status-notice"><strong>AI evaluation has not run</strong><span>The summary above comes from captured profile fields and deterministic screening. No AI score, evidence review, or introduction draft exists for this candidate yet.</span></section>
}
else
{
    <section class="manual-notice ai-status-notice"><strong>AI evaluation complete</strong><span>This record includes a persisted evaluation from @latestEvaluation.Evaluation.EvaluatorModel using prompt @latestEvaluation.Evaluation.PromptVersion.</span></section>
}
@if (detail.Profile is { } profile)
{
    <section class="panel captured-profile" aria-labelledby="captured-profile-heading">
        <div class="panel-heading"><div><h2 id="captured-profile-heading">Captured profile details</h2><span class="supporting">Normalized directly from the saved Startup School profile · parser @profile.ParserVersion · @profile.Completeness.ToString("P0") complete</span></div></div>
        <dl class="profile-detail-grid">
            <div><dt>Introduction</dt><dd>@(profile.Introduction ?? "Not stated")</dd></div>
            <div><dt>Career background</dt><dd>@(profile.CareerBackground ?? "Not stated")</dd></div>
            <div><dt>Building background</dt><dd>@(profile.BuildingBackground ?? "Not stated")</dd></div>
            <div><dt>Startup</dt><dd>@(profile.StartupDescription ?? "Not stated")</dd></div>
            <div><dt>Problem</dt><dd>@(profile.ProblemDescription ?? "Not stated")</dd></div>
            <div><dt>Customer</dt><dd>@(profile.CustomerDescription ?? "Not stated")</dd></div>
            <div><dt>Solution</dt><dd>@(profile.SolutionDescription ?? "Not stated")</dd></div>
            <div><dt>Desired cofounder</dt><dd>@(profile.DesiredCofounderRole ?? "Not stated")</dd></div>
            <div><dt>Operating roles</dt><dd>@(profile.Roles.Count == 0 ? "Not stated" : string.Join(", ", profile.Roles))</dd></div>
            <div><dt>Traction claims</dt><dd>@(profile.TractionClaims.Count == 0 ? "Not stated" : string.Join(" · ", profile.TractionClaims))</dd></div>
            <div><dt>Desired skills</dt><dd>@(profile.DesiredCofounderSkills.Count == 0 ? "Not stated" : string.Join(", ", profile.DesiredCofounderSkills))</dd></div>
            <div><dt>Industries</dt><dd>@(profile.Industries.Count == 0 ? "Not stated" : string.Join(", ", profile.Industries))</dd></div>
        </dl>
    </section>
}
else
{
    <section class="panel"><div class="panel-heading"><h2>Captured profile details</h2></div><p class="empty-state">The profile snapshot is saved, but normalized profile fields are not available yet.</p></section>
}
<section class="score-strip" aria-label="Candidate scores"><div><span>Founder quality</span><strong>@detail.Candidate.FounderQualityScore?.ToString("0.0")</strong></div><div><span>Local fit</span><strong>@detail.Candidate.OurFitScore?.ToString("0.0")</strong></div><div><span>Confidence</span><strong>@detail.Candidate.Confidence?.ToString("0.00")</strong></div><div><span>Activity</span><strong>@detail.Candidate.ActivityScore?.ToString("0.0")</strong></div><div><span>Risk penalty</span><strong>@detail.Candidate.RiskPenalty?.ToString("0.0")</strong></div><div class="priority-score"><span>Invitation priority</span><strong>@detail.Candidate.InvitationPriority?.ToString("0.0")</strong></div></section>

<div class="review-workspace">
    <div class="stack">
        <section class="panel"><div class="panel-heading"><div><h2>Why this recommendation</h2><span class="supporting">@latestEvaluation?.Evaluation.Recommendation · scorecard @latestEvaluation?.Evaluation.ScorecardVersion · model @latestEvaluation?.Evaluation.EvaluatorModel</span></div><span class="pill @(detail.Candidate.Status == CandidateStatus.ManualReview ? "attention" : "positive")">@detail.Candidate.Status</span></div>
            @if (latestEvaluation is null) { <p class="empty-state">No completed evaluation is available.</p> }
            else { <div class="evidence-grid"><div><h3>Positive signals</h3><ul>@foreach (var signal in latestEvaluation.PositiveSignals) { <li>@signal</li> }</ul></div><div><h3>Concerns</h3><ul>@foreach (var risk in latestEvaluation.Risks) { <li><strong>@risk.Key · −@risk.Penalty</strong><span>@(risk.Reason ?? risk.EvidenceJson)</span></li> }</ul></div><div><h3>Missing evidence</h3><ul>@foreach (var missing in latestEvaluation.MissingEvidence) { <li>@missing</li> }</ul></div><div><h3>Questions to validate</h3><ol>@foreach (var question in latestEvaluation.PriorityQuestions) { <li>@question</li> }</ol></div></div>
                <details><summary>Category evidence and arithmetic</summary><div class="category-list">@foreach (var category in latestEvaluation.Categories) { <div><strong>@category.Key</strong><span>@category.Score / @category.Maximum</span><p>@(category.Reason ?? category.EvidenceJson)</p></div> }</div></details> }
        </section>

        <section class="panel"><div class="panel-heading"><div><h2>Introduction drafts</h2><span class="supporting">Generated text is immutable. Human edits create an auditable revision.</span></div>@if (generatedDraft is not null) { <span class="pill @(generatedDraft.Status == InvitationDraftStatus.Reviewed ? "positive" : "warning")">@generatedDraft.Status</span> }</div>
            @if (generatedDraft is null) { <p class="empty-state">No invitation draft exists for the latest evaluation.</p> }
            else { <div class="draft-grid"><article><h3>Short draft</h3><pre id="short-draft">@(activeRevision?.ShortDraft ?? generatedDraft.ShortDraft)</pre><button type="button" class="ghost" data-copy-source="short-draft">Copy short draft</button></article><article><h3>Detailed draft</h3><pre id="detailed-draft">@(activeRevision?.DetailedDraft ?? generatedDraft.DetailedDraft)</pre><button type="button" class="ghost" data-copy-source="detailed-draft">Copy detailed draft</button></article></div>
                <div class="inline-actions"><form method="post" asp-page-handler="ReviewDraft"><input type="hidden" name="id" value="@detail.Candidate.Id" /><input type="hidden" name="draftId" value="@generatedDraft.Id" /><button class="secondary">Mark reviewed</button></form></div>
                <details class="edit-draft"><summary>Edit as a new revision</summary><form method="post" asp-page-handler="SaveDraft" class="form-grid"><input type="hidden" name="id" value="@detail.Candidate.Id" /><input type="hidden" name="sourceDraftId" value="@generatedDraft.Id" /><div class="wide"><label for="shortDraft">Short draft</label><textarea id="shortDraft" name="shortDraft" maxlength="350">@(activeRevision?.ShortDraft ?? generatedDraft.ShortDraft)</textarea></div><div class="wide"><label for="detailedDraft">Detailed draft</label><textarea id="detailedDraft" name="detailedDraft" maxlength="2000">@(activeRevision?.DetailedDraft ?? generatedDraft.DetailedDraft)</textarea></div><div class="wide"><button class="primary">Validate and save revision</button></div></form></details> }
        </section>

<section class="panel"><div class="panel-heading"><h2>Profile and evaluation history</h2><span class="supporting">Derived history remains after raw retention.</span></div><div class="history-columns"><div><h3>Snapshots</h3><ol class="timeline">@foreach (var snapshot in detail.Snapshots) { <li><time>@snapshot.Snapshot.CapturedAtUtc.ToLocalTime().ToString("g")</time><div><strong>@snapshot.Snapshot.Status · @snapshot.Snapshot.SourceAccountId</strong><span class="supporting">Parser @snapshot.Snapshot.ParserVersion · raw @(snapshot.RawArtifactAvailable ? "retained" : "deleted")</span>@if (snapshot.Changes.Count > 0) { <details><summary>@snapshot.Changes.Count relevant changes</summary><ul>@foreach (var change in snapshot.Changes) { <li>@change.Field: @change.ChangeKind</li> }</ul></details> }</div></li> }</ol></div><div><h3>Evaluations</h3><ol class="timeline">@foreach (var evaluation in detail.Evaluations) { <li><time>@evaluation.Evaluation.CreatedAtUtc.ToLocalTime().ToString("g")</time><div><strong>@evaluation.Evaluation.Recommendation · @evaluation.Evaluation.FinalScore.ToString("0.0")</strong><span class="supporting">@evaluation.Evaluation.ScorecardVersion / @evaluation.Evaluation.PromptVersion / @evaluation.Evaluation.EvaluatorModel</span></div></li> }</ol></div></div></section>
    </div>

    <aside class="stack decision-rail">
        <section class="panel"><div class="panel-heading"><h2>Queue action</h2></div>@if (detail.QueueEntry is not null) { <p><span class="pill positive">@detail.QueueEntry.QueueKind #@detail.QueueEntry.Position</span></p> } else { <form method="post" asp-page-handler="Queue"><input type="hidden" name="id" value="@detail.Candidate.Id" /><label for="queueKind">Planning lane</label><select id="queueKind" name="queueKind"><option value="Primary">Primary</option><option value="Reserve">Reserve</option></select><label class="check"><input type="checkbox" name="manualOverride" value="true" /> Explicitly include despite soft eligibility</label><button class="primary">Add to local queue</button></form> }</section>
        <section class="panel"><div class="panel-heading"><h2>Record outcome</h2></div><form method="post" asp-page-handler="Outcome"><input type="hidden" name="id" value="@detail.Candidate.Id" /><label for="outcome">Human-confirmed state</label><select id="outcome" name="outcome">@foreach (var outcome in HomeBusinessAssistant.Host.Pages.FounderScout.Candidates.DetailsModel.Outcomes) { <option value="@outcome">@outcome</option> }</select><label for="notes">Optional notes</label><textarea id="notes" name="notes" maxlength="2000"></textarea><button class="secondary">Record outcome</button></form></section>
        <section class="panel"><div class="panel-heading"><h2>Identity and profile</h2></div><ul class="detail-list"><li><strong>Location</strong><span class="supporting">@(detail.Candidate.NormalizedLocation ?? "Not stated")</span></li><li><strong>Technical posture</strong><span class="supporting">@detail.Candidate.TechnicalStatus</span></li><li><strong>Founder commitment</strong><span class="supporting">@detail.Candidate.CommitmentStatus</span></li><li><strong>Idea posture</strong><span class="supporting">@detail.Candidate.IdeaCommitmentStatus</span></li><li><strong>Identity conflicts</strong><span class="supporting">@detail.IdentityConflicts.Count(conflict => !conflict.Resolved) unresolved</span></li></ul></section>
        <section class="panel danger-zone"><div class="panel-heading"><h2>Raw-data retention</h2></div><p class="supporting">Delete only captured raw files for this candidate. Normalized profile, evaluations, drafts, scores, and timeline remain.</p><form method="post" asp-page-handler="DeleteRaw" data-confirm="Delete eligible raw HTML/text artifacts for this candidate? Derived history will remain, but raw files cannot be recovered from Founder Scout."><input type="hidden" name="id" value="@detail.Candidate.Id" /><button class="danger">Delete eligible raw data</button></form></section>
    </aside>
</div>

<section class="panel timeline-panel"><div class="panel-heading"><h2>Audit timeline</h2><span class="supporting">Append-only candidate actions</span></div><ol class="timeline">@foreach (var action in detail.Timeline) { <li><time>@action.OccurredAtUtc.ToLocalTime().ToString("g")</time><div><strong>@action.ActionType</strong><span class="supporting">@action.Actor · @action.CorrelationId</span>@if (!string.IsNullOrWhiteSpace(action.Notes)) { <p>@action.Notes</p> }</div></li> }</ol></section>
