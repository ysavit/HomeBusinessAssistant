@page
@model HomeBusinessAssistant.Host.Pages.FounderScout.IndexModel
@{
    ViewData["Title"] = "Founder Scout";
}

<header class="page-header"><div><p class="eyebrow">Local founder review workspace</p><h1>Founder Scout</h1><p>Move from durable discovery to evidence-led review, a manual planning queue, and recorded outcomes. Invitations always stay in your hands.</p></div><div class="page-actions"><form method="post" asp-page-handler="Discover"><button class="secondary">Run discovery</button></form><form method="post" asp-page-handler="Analyze"><button class="secondary">Analyze pending</button></form><form method="post" asp-page-handler="Reports"><button class="primary">Regenerate reports</button></form></div></header>
<partial name="_Tabs" />

@if (Model.Attention is not null) { <p class="empty-state attention-text">@Model.Attention</p> }
else if (Model.Dashboard is not null)
{
    <section class="manual-notice"><strong>Manual invitation boundary</strong><span>This workspace drafts, validates, copies, and records. It has no route or action that sends a message.</span></section>
    <section class="facts-strip" aria-label="Founder Scout status">
        <div class="fact"><span>Candidates</span><strong>@Model.Dashboard.Candidates</strong></div>
        <div class="fact"><span>New / updated</span><strong>@Model.Dashboard.NewOrUpdated</strong></div>
        <div class="fact"><span>Pending analysis</span><strong>@Model.Dashboard.PendingAnalysis</strong></div>
        <div class="fact"><span>Drafts ready</span><strong>@Model.Dashboard.DraftsReady</strong></div>
        <div class="fact"><span>Primary / reserve</span><strong>@Model.Dashboard.PrimaryQueue / @Model.Dashboard.ReserveQueue</strong></div>
        <div class="fact"><span>Attention</span><strong>@Model.Dashboard.AttentionItems</strong></div>
    </section>
    <div class="content-grid">
        <div class="stack">
            <section class="table-shell"><div class="panel panel-heading"><div><h2>Invitation priority</h2><span class="supporting">Stable order: priority, confidence, activity, name, ID.</span></div><a asp-page="/FounderScout/Candidates/Index">Review all</a></div>
                @if (Model.TopCandidates.Count == 0) { <p class="empty-state">No evaluated candidates yet. Run discovery, then analyze captured profiles.</p> }
                else { <div class="table-scroll"><table><thead><tr><th>Rank</th><th>Candidate</th><th>Quality</th><th>Fit</th><th>Confidence</th><th>Priority</th><th>State</th></tr></thead><tbody>@foreach (var item in Model.TopCandidates) { <tr><td class="rank-cell">@item.Rank</td><td><a asp-page="/FounderScout/Candidates/Details" asp-route-id="@item.CandidateId">@item.DisplayName</a><span class="supporting">@item.Recommendation</span></td><td>@item.FounderQualityScore?.ToString("0.0")</td><td>@item.OurFitScore?.ToString("0.0")</td><td>@item.Confidence?.ToString("0.00")</td><td><strong>@item.InvitationPriority?.ToString("0.0")</strong></td><td><span class="pill @(item.NeedsManualReview ? "attention" : "muted")">@item.Status</span></td></tr> }</tbody></table></div> }
            </section>
            <section class="table-shell"><div class="panel panel-heading"><div><h2>Recent agent work</h2><span class="supporting">Discovery, analysis, and report occurrences launched through Runner.</span></div><a asp-page="/Runs/Index" asp-route-agentId="founder-scout">All runs</a></div>@if (Model.RecentRuns.Count == 0) { <p class="empty-state">No Founder Scout runs recorded yet.</p> } else { <div class="table-scroll"><table><thead><tr><th>Command</th><th>Status</th><th>Due</th><th>Attempt</th></tr></thead><tbody>@foreach (var run in Model.RecentRuns) { <tr><td><a asp-page="/Runs/Details" asp-route-id="@run.Run.Id.Value">@run.CommandName</a></td><td>@run.Run.Status</td><td>@run.DueAtUtc.ToLocalTime().ToString("g")</td><td>@run.AttemptNumber</td></tr> }</tbody></table></div> }</section>
        </div>
        <aside class="stack">
            <section class="panel"><div class="panel-heading"><h2>Attention rail</h2><span class="pill @(Model.Dashboard.AttentionItems > 0 ? "attention" : "positive")">@Model.Dashboard.AttentionItems</span></div><ul class="compact-list"><li><strong>@Model.Dashboard.DraftsNeedReview drafts</strong><span class="supporting">Need a human review or revision.</span></li><li><strong>@Model.Dashboard.PendingScreening profiles</strong><span class="supporting">Await deterministic screening.</span></li>@foreach (var account in Model.Dashboard.Accounts.Where(account => account.LastErrorReasonCode is not null || account.SessionStatus.ToString() != "Healthy")) { <li><strong>@account.DisplayName</strong><span class="supporting">@account.SessionStatus · @(account.LastErrorReasonCode ?? "authentication attention")</span></li> }</ul></section>
            <section class="panel"><div class="panel-heading"><h2>Latest reports</h2><a asp-page="/FounderScout/Operations/Index">All reports</a></div>@if (Model.Dashboard.LatestReports.Count == 0) { <p class="supporting">No reports generated yet.</p> } else { <ul class="compact-list">@foreach (var report in Model.Dashboard.LatestReports.Take(5)) { <li><strong>@report.ReportType · @report.Format</strong><span class="supporting">@report.CreatedAtUtc.ToLocalTime().ToString("g") · @report.RowCount rows</span></li> }</ul> }</section>
        </aside>
    </div>
}
