@page
@model HomeBusinessAssistant.Host.Pages.FounderScout.Operations.IndexModel
@{
    ViewData["Title"] = "Founder Scout operations";
}

<header class="page-header"><div><p class="eyebrow">Accounts, discovery, reports, retention</p><h1>Operations</h1><p>Review safe account and segment state, launch work through Runner, and manage bounded local artifacts.</p></div><a class="button-link ghost" asp-page="/Agents/Configuration" asp-route-id="founder-scout">View settings</a></header>
<partial name="../_Tabs" />

<section class="panel"><div class="panel-heading"><div><h2>Browser accounts</h2><span class="supporting">Authentication opens a headed browser interactively in the current logged-in user session. Passwords are never stored.</span></div></div>@if (Model.Accounts.Count == 0) { <p class="empty-state">No dedicated Founder Scout browser accounts are configured.</p> } else { <div class="account-grid">@foreach (var account in Model.Accounts) { <article class="metric-card account-card"><div class="panel-heading"><div><strong>@account.DisplayName</strong><span>@account.Id</span></div><span class="pill @(account.SessionStatus.ToString() == "Healthy" ? "positive" : account.LastErrorReasonCode is null ? "muted" : "attention")">@account.SessionStatus</span></div><dl><dt>Safe profile path</dt><dd class="code">@account.BrowserProfileRelativePath</dd><dt>Last authentication</dt><dd>@(account.LastAuthenticatedAtUtc?.ToLocalTime().ToString("g") ?? "Never")</dd><dt>Last success</dt><dd>@(account.LastSuccessfulRunAtUtc?.ToLocalTime().ToString("g") ?? "Never")</dd><dt>Last failure</dt><dd>@(account.LastFailedRunAtUtc?.ToLocalTime().ToString("g") ?? "None")</dd><dt>Cooldown / suspension</dt><dd>@(account.SuspendedUntilUtc?.ToLocalTime().ToString("g") ?? "None")</dd><dt>Attention</dt><dd>@(account.LastErrorReasonCode ?? "None")</dd><dt>Segments</dt><dd>@account.AssignedSegmentIds.Count</dd></dl><div class="inline-actions"><form method="post" asp-page-handler="Authenticate"><input type="hidden" name="accountId" value="@account.Id" /><button class="secondary">Authenticate interactively</button></form><form method="post" asp-page-handler="Discover"><input type="hidden" name="accountId" value="@account.Id" /><button class="ghost">Run now</button></form><form method="post" asp-page-handler="Diagnose"><input type="hidden" name="accountId" value="@account.Id" /><button class="ghost">Diagnose</button></form><form method="post" asp-page-handler="AccountEnabled"><input type="hidden" name="accountId" value="@account.Id" /><button class="ghost" name="enabled" value="@(!account.Enabled)">@(account.Enabled ? "Pause" : "Resume")</button></form>@if (account.LastErrorReasonCode is not null) { <form method="post" asp-page-handler="ClearAttention"><input type="hidden" name="accountId" value="@account.Id" /><button class="ghost">Mark reviewed</button></form> }</div></article> }</div> }</section>

<section class="table-shell"><div class="panel panel-heading"><div><h2>Discovery segments</h2><span class="supporting">Yield and error counters are persisted across runs.</span></div></div>@if (Model.Segments.Count == 0) { <p class="empty-state">No discovery segments are configured.</p> } else { <div class="table-scroll"><table><thead><tr><th>Segment / safe filters</th><th>Account</th><th>Priority</th><th>Viewed</th><th>New</th><th>Duplicates</th><th>Low-yield runs</th><th>Errors</th><th>Last run</th><th>State</th></tr></thead><tbody>@foreach (var segment in Model.Segments) { <tr><td><strong>@segment.Name</strong><span class="supporting">@segment.Id</span><details><summary>Configuration</summary><pre>@segment.ConfigurationJson</pre></details></td><td>@(segment.AssignedAccountId ?? "Unassigned")</td><td>@segment.Priority</td><td>@segment.ViewedCount</td><td>@segment.NewCount</td><td>@segment.DuplicateCount</td><td>@segment.ConsecutiveLowYieldRuns</td><td>@segment.ErrorCount</td><td>@(segment.LastRunAtUtc?.ToLocalTime().ToString("g") ?? "Never")</td><td><form method="post" asp-page-handler="SegmentPaused"><input type="hidden" name="segmentId" value="@segment.Id" /><button class="ghost" name="paused" value="@segment.Enabled">@(segment.Enabled ? "Pause" : "Resume")</button></form></td></tr> }</tbody></table></div> }</section>

<div class="content-grid">
    <section class="table-shell"><div class="panel panel-heading"><div><h2>Reports</h2><span class="supporting">All formats share one selected row set and stable order.</span></div><div class="inline-actions"><form method="post" asp-page-handler="Report"><button class="primary" name="type" value="all">Generate all</button></form><form method="post" asp-page-handler="Report"><button class="ghost" name="type" value="top-candidates">Top candidates</button></form><form method="post" asp-page-handler="Report"><button class="ghost" name="type" value="invitation-queue">Invitation queue</button></form></div></div>@if (Model.Reports.Count == 0) { <p class="empty-state">No reports have been generated.</p> } else { <div class="table-scroll"><table><thead><tr><th>Report</th><th>Format</th><th>Rows</th><th>Created</th><th>Retention</th><th>Hash</th></tr></thead><tbody>@foreach (var report in Model.Reports) { <tr><td><a asp-page-handler="Report" asp-route-id="@report.Id" target="@(report.Format == "html" ? "_blank" : null)" rel="@(report.Format == "html" ? "noopener noreferrer" : null)">@report.ReportType</a></td><td>@report.Format</td><td>@report.RowCount</td><td>@report.CreatedAtUtc.ToLocalTime().ToString("g")</td><td>@report.DeleteAfterUtc.ToLocalTime().ToString("d")</td><td class="code">@report.FileHash[..12]…</td></tr> }</tbody></table></div> }</section>
    <aside class="stack"><section class="panel danger-zone"><div class="panel-heading"><h2>Apply raw retention</h2></div><p class="supporting">Deletes eligible expired raw HTML/text/screenshot files only. Current snapshots, active/diagnostic artifacts, normalized profiles, evaluations, actions, and drafts remain.</p><form method="post" asp-page-handler="Retention" data-confirm="Apply configured raw-artifact retention now? Eligible raw files will be deleted, while all derived records remain."><button class="danger">Apply raw retention</button></form></section><section class="panel"><div class="panel-heading"><h2>Operational boundary</h2></div><ul class="detail-list"><li><strong>Local only</strong><span class="supporting">Kestrel stays on 127.0.0.1.</span></li><li><strong>No automatic sending</strong><span class="supporting">No invitation, email, or message transport is registered.</span></li><li><strong>Runner owned</strong><span class="supporting">Discovery, analysis, authentication, and reports are launched as durable occurrences.</span></li></ul></section></aside>
</div>
