@page
@model HomeBusinessAssistant.Host.Pages.Settings.IndexModel
@{
    ViewData["Title"] = "Settings & health";
}

<header class="page-header"><div><p class="eyebrow">Local system</p><h1>Settings &amp; health</h1><p>Bootstrap paths are read-only here. Agent settings and schedules are versioned in SQLite.</p></div><div class="page-actions"><form method="post" asp-page-handler="AgentOnboarding"><button class="secondary">Add or configure agents</button></form><a class="button-link secondary" asp-page="/Onboarding">Onboarding readiness</a><a class="button-link primary" asp-page-handler="Diagnostics">Download diagnostics</a></div></header>

<section class="facts-strip" aria-label="System facts"><div class="fact"><span>Host version</span><strong>@Model.HostVersion</strong></div><div class="fact"><span>Uptime</span><strong>@Model.Uptime.ToString("g")</strong></div><div class="fact"><span>Runner</span><strong>@(Model.RunnerPresent ? "Present" : "Missing")</strong></div><div class="fact"><span>Database</span><strong>@(Model.Database?.JournalMode.ToUpperInvariant() ?? "Unavailable")</strong></div><div class="fact"><span>Migration</span><strong class="code">@(Model.Database?.Migration ?? "—")</strong></div></section>

<div class="content-grid">
    <div class="stack">
        <section class="panel"><div class="panel-heading"><h2>Bootstrap configuration</h2></div>@if (Model.Bootstrap is null) { <p class="empty-state">Production bootstrap configuration is unavailable.</p> } else { <div class="form-grid"><div class="wide"><strong>Data root</strong><p class="supporting code">@Model.Bootstrap.DataDirectory</p></div><div class="wide"><strong>Agent root</strong><p class="supporting code">@Model.Bootstrap.AgentDirectory</p></div><div class="wide"><strong>Loopback URL</strong><p class="supporting code">@Model.Bootstrap.Url</p></div><div class="wide"><strong>Runner path</strong><p class="supporting code">@Model.Bootstrap.RunnerExecutablePath</p></div></div><p class="field-help">Changing bootstrap paths or the port requires updating appsettings/environment/command-line configuration and restarting Host.</p> }</section>
        <section class="table-shell"><div class="panel panel-heading"><h2>Orchestration loops</h2></div>@if (Model.Loops.Count == 0) { <p class="empty-state">Loop health is not available in this Host composition.</p> } else { <div class="table-scroll"><table><thead><tr><th>Loop</th><th>Status</th><th>Last attempt</th><th>Last success</th><th>Last error</th></tr></thead><tbody>@foreach (var loop in Model.Loops) { var state = loop.IsRunning ? "Running" : loop.LastErrorCode is null ? "Healthy" : "Attention"; <tr><td>@loop.Name</td><td><span class="pill @(loop.LastErrorCode is null ? "positive" : "warning")">@state</span></td><td>@loop.LastAttemptAtUtc?.ToLocalTime().ToString("g")</td><td>@loop.LastSuccessAtUtc?.ToLocalTime().ToString("g")</td><td>@(loop.LastErrorCode ?? "—")</td></tr> }</tbody></table></div> }</section>
        <section class="panel"><div class="panel-heading"><h2>Storage and database</h2></div>@if (Model.Database is not null) { <div class="metric-grid"><div class="metric-card"><span>Database size</span><strong>@Model.Database.DatabaseSizeBytes.ToString("N0") B</strong></div><div class="metric-card"><span>Free disk</span><strong>@((Model.Database.AvailableDiskBytes / 1_073_741_824d).ToString("N1")) GiB</strong></div><div class="metric-card"><span>Foreign keys</span><strong>@(Model.Database.ForeignKeysEnabled ? "On" : "Off")</strong></div><div class="metric-card"><span>Busy timeout</span><strong>@Model.Database.BusyTimeoutMilliseconds ms</strong></div></div> }</section>
    </div>
    <aside class="stack"><section class="panel"><div class="panel-heading"><h2>Onboarding status</h2><span class="pill @(Model.AgentOnboarding?.HasPendingAgents == true ? "attention" : "muted")">@(Model.AgentOnboarding?.PendingAgentCount ?? 0) pending</span></div>@if (Model.Onboarding is null) { <p class="empty-state">Onboarding status is unavailable.</p> } else { <ul class="detail-list"><li><strong>Session</strong><span class="supporting">@Model.Onboarding.Session.Kind · @Model.Onboarding.Session.Status</span></li><li><strong>Step</strong><span class="supporting code">@Model.Onboarding.Session.CurrentStep</span></li><li><strong>Updated</strong><span class="supporting">@Model.Onboarding.Session.UpdatedAtUtc.ToLocalTime().ToString("g")</span></li></ul><div class="inline-actions"><form method="post" asp-page-handler="AgentOnboarding"><button class="secondary">Add or configure agents</button></form><a asp-page="/Audit/Index" asp-route-action="onboarding.">Onboarding history</a></div> }</section><section class="panel"><div class="panel-heading"><h2>Diagnostics export</h2></div><p class="supporting">The bounded ZIP includes a SHA-256 manifest, safe health metadata, attention, run status, daily summary headers, and explicit exclusions. Database files, secrets, configuration payloads, browser data, profiles, prompts, drafts, screenshots, artifacts, and raw logs stay out.</p><a class="button-link secondary" asp-page-handler="Diagnostics">Create export</a></section><section class="panel"><div class="panel-heading"><h2>Notification policy</h2></div>@if (Model.Policy is null) { <p class="empty-state">Operational policy is unavailable.</p> } else { <ul class="detail-list"><li><strong>Quiet hours</strong><span class="supporting">@Model.Policy.QuietHoursStartLocal – @Model.Policy.QuietHoursEndLocal local</span></li><li><strong>Global throttle</strong><span class="supporting">@Model.Policy.GlobalThrottleSeconds seconds</span></li><li><strong>Per-category throttle</strong><span class="supporting">@Model.Policy.PerKeyThrottleMinutes minutes</span></li><li><strong>Digest time</strong><span class="supporting">@Model.Policy.DailySummaryTimeLocal local</span></li></ul><form method="post" asp-page-handler="DailySummary"><button class="ghost">Generate today’s summary</button></form> }</section><section class="panel danger-zone"><div class="panel-heading"><h2>Retention</h2></div><p class="supporting">Preview: @Model.RetentionPreview?.Considered eligible record(s), @Model.RetentionPreview?.BytesReclaimed.ToString("N0") bytes. Active-run artifacts and append-only audit/configuration history are protected; paths outside the data root fail closed.</p><form method="post" asp-page-handler="Retention" data-confirm="Apply the displayed local retention policy? Eligible files cannot be restored from this action."><button class="danger">Apply retention</button></form></section><section class="panel"><div class="panel-heading"><h2>Database backup</h2></div><p class="supporting">Creates a SQLite-consistent set for assistant.db and founders.db. Secrets, browser profiles, logs, and raw artifacts are excluded.</p><form method="post" asp-page-handler="Backup"><button class="secondary">Create verified backup</button></form>@if (Model.Backups.Count == 0) { <p class="empty-state">No completed backup sets.</p> } else { <ul class="detail-list">@foreach (var backup in Model.Backups.Take(5)) { <li><strong class="code">@backup.BackupSetId</strong><span class="supporting">@backup.CreatedAtUtc.ToLocalTime().ToString("g") · @backup.SizeBytes.ToString("N0") B · @(backup.IsValid ? "valid" : backup.ValidationCode)</span></li> }</ul> }<a asp-page="/About">Version and restore details</a></section></aside>
</div>

<section class="table-shell"><div class="panel panel-heading"><h2>Local notification delivery</h2><a asp-page="/Attention/Index">Attention history</a></div>@if (Model.Notifications.Count == 0) { <p class="empty-state">No durable local notifications have been queued.</p> } else { <div class="table-scroll"><table><thead><tr><th>Created</th><th>Severity</th><th>Notification</th><th>Status</th><th>Attempts</th><th>Delivered</th></tr></thead><tbody>@foreach (var item in Model.Notifications) { <tr><td>@item.CreatedAtUtc.ToLocalTime().ToString("g")</td><td>@item.Severity</td><td><strong>@item.Title</strong><span class="supporting">@item.Message</span></td><td><span class="pill @(item.Status.ToString() == "Delivered" ? "positive" : item.Status.ToString() == "Pending" ? "warning" : "muted")">@item.Status</span></td><td>@item.DeliveryAttempts</td><td>@(item.DeliveredAtUtc?.ToLocalTime().ToString("g") ?? "—")</td></tr> }</tbody></table></div> }</section>
