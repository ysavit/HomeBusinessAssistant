@page
@model HomeBusinessAssistant.Host.Pages.Audit.IndexModel
@{
    ViewData["Title"] = "Audit";
}

<header class="page-header"><div><p class="eyebrow">Append-only records</p><h1>Audit</h1><p>Review redacted local control-plane decisions. Audit rows cannot be edited or deleted here.</p></div></header>

<form method="get" class="toolbar" aria-label="Audit filters"><div class="inline-actions"><label>Actor <input name="actor" value="@Model.Query.Actor" /></label><label>Action contains <input name="action" value="@Model.Query.Action" /></label><label>Target type <input name="targetType" value="@Model.Query.TargetType" /></label><label>Outcome <input name="outcome" value="@Model.Query.Outcome" /></label><label>Agent <select name="agentId"><option value="">All agents</option>@foreach (var agent in Model.Agents) { <option value="@agent.Definition.Id.Value" selected="@(Model.Query.AgentId == agent.Definition.Id.Value)">@agent.Definition.DisplayName</option> }</select></label></div><button class="secondary">Apply filters</button></form>

<section class="table-shell" aria-labelledby="audit-list-title">
    <h2 id="audit-list-title" class="sr-only">Audit events</h2>
    @if (Model.Events.Items.Count == 0) { <p class="empty-state">No audit events match these filters.</p> }
    else { <div class="table-scroll"><table><thead><tr><th>Time</th><th>Actor</th><th>Action</th><th>Target</th><th>Outcome</th><th>Correlation</th><th>Run</th></tr></thead><tbody>@foreach (var item in Model.Events.Items) { <tr><td><a asp-page="/Audit/Details" asp-route-id="@item.Id">@item.TimestampUtc.ToLocalTime().ToString("g")</a></td><td>@item.ActorType<span class="supporting">@item.ActorId</span></td><td>@item.Action</td><td>@item.TargetType<span class="supporting code">@item.TargetId</span></td><td><span class="pill @(item.Outcome.ToString() == "Succeeded" ? "positive" : item.Outcome.ToString() == "Failed" ? "attention" : "muted")">@item.Outcome</span></td><td class="code">@item.CorrelationId</td><td>@if (item.RunId is not null) { <a asp-page="/Runs/Details" asp-route-id="@item.RunId.Value.Value" class="code">@item.RunId</a> } else { <span>—</span> }</td></tr> }</tbody></table></div> }
    <div class="pagination"><span>Page @Model.Events.PageNumber of @Model.Events.TotalPages · @Model.Events.TotalCount event(s)</span><div class="inline-actions">@if (Model.Events.PageNumber > 1) { <a class="button-link ghost" asp-route-pageNumber="@(Model.Events.PageNumber - 1)" asp-route-actor="@Model.Query.Actor" asp-route-action="@Model.Query.Action" asp-route-targetType="@Model.Query.TargetType" asp-route-outcome="@Model.Query.Outcome" asp-route-agentId="@Model.Query.AgentId">Previous</a> }@if (Model.Events.PageNumber < Model.Events.TotalPages) { <a class="button-link ghost" asp-route-pageNumber="@(Model.Events.PageNumber + 1)" asp-route-actor="@Model.Query.Actor" asp-route-action="@Model.Query.Action" asp-route-targetType="@Model.Query.TargetType" asp-route-outcome="@Model.Query.Outcome" asp-route-agentId="@Model.Query.AgentId">Next</a> }</div></div>
</section>
