@page
@model HomeBusinessAssistant.Host.Pages.Attention.IndexModel
@using HomeBusinessAssistant.Application.Operations
@{
    ViewData["Title"] = "Attention";
    var active = Model.Items.Where(item => item.Status is AttentionStatus.Active or AttentionStatus.Acknowledged).ToArray();
}

<header class="page-header"><div><p class="eyebrow">Durable operations</p><h1>Attention</h1><p>Repeated observations are deduplicated. Acknowledgement records awareness; only observed recovery resolves a condition.</p></div><form method="post" asp-page-handler="Refresh"><button class="primary">Scan now</button></form></header>

<section class="facts-strip" aria-label="Attention summary"><div class="fact"><span>Open</span><strong>@active.Length</strong></div><div class="fact"><span>Unacknowledged</span><strong>@active.Count(item => item.Status == AttentionStatus.Active)</strong></div><div class="fact"><span>Critical / error</span><strong>@active.Count(item => item.Severity is AttentionSeverity.Critical or AttentionSeverity.Error)</strong></div><div class="fact"><span>Resolved history</span><strong>@Model.Items.Count(item => item.Status == AttentionStatus.Resolved)</strong></div></section>

<div class="content-grid"><div class="stack"><section class="table-shell"><div class="panel panel-heading"><h2>Current conditions</h2><span class="pill @(active.Length == 0 ? "positive" : "attention")">@active.Length open</span></div>@if (active.Length == 0) { <p class="empty-state">No active attention items.</p> } else { <div class="table-scroll"><table><thead><tr><th>Severity</th><th>Condition</th><th>Last observed</th><th>Count</th><th>Status</th><th>Action</th></tr></thead><tbody>@foreach (AttentionItem item in active) { <tr><td><span class="pill @(item.Severity is AttentionSeverity.Critical or AttentionSeverity.Error ? "attention" : "warning")">@item.Severity</span></td><td><strong>@item.Title</strong><span class="supporting">@item.Message</span><span class="supporting code">@item.Category · @item.DedupeKey</span></td><td>@item.LastObservedAtUtc.ToLocalTime().ToString("g")</td><td>@item.OccurrenceCount</td><td>@item.Status</td><td>@if (item.Status == AttentionStatus.Active) { <form method="post" asp-page-handler="Acknowledge"><input type="hidden" name="id" value="@item.Id" /><button class="ghost">Acknowledge</button></form> } else { <span class="supporting">Awaiting recovery</span> }</td></tr> }</tbody></table></div> }</section>
<section class="table-shell"><div class="panel panel-heading"><h2>Resolved timeline</h2></div>@{ var resolved = Model.Items.Where(item => item.Status == AttentionStatus.Resolved).ToArray(); }@if (resolved.Length == 0) { <p class="empty-state">No recently resolved conditions.</p> } else { <div class="table-scroll"><table><thead><tr><th>Condition</th><th>First seen</th><th>Resolved</th><th>Observations</th></tr></thead><tbody>@foreach (AttentionItem item in resolved) { <tr><td>@item.Title</td><td>@item.FirstObservedAtUtc.ToLocalTime().ToString("g")</td><td>@item.ResolvedAtUtc?.ToLocalTime().ToString("g")</td><td>@item.OccurrenceCount</td></tr> }</tbody></table></div> }</section></div>
<aside class="stack"><section class="panel"><div class="panel-heading"><h2>Daily summaries</h2></div>@if (Model.DailySummaries.Count == 0) { <p class="empty-state">The first local-day summary is generated after the configured digest time.</p> } else { <ul class="compact-list">@foreach (DailySummary summary in Model.DailySummaries.Take(10)) { <li><strong>@summary.LocalDate · generation @summary.GenerationNumber</strong><span class="supporting">@summary.SummaryText</span><span class="supporting code">@summary.TimeZoneId · @summary.SourceHash[..12]…</span></li> }</ul> }</section><section class="panel"><div class="panel-heading"><h2>Lifecycle</h2></div><ul class="detail-list"><li><strong>Active</strong><span class="supporting">The signal is currently observed.</span></li><li><strong>Acknowledged</strong><span class="supporting">Seen by an operator, still active.</span></li><li><strong>Resolved</strong><span class="supporting">A later scan observed recovery.</span></li></ul></section></aside></div>
