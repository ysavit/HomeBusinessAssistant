{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://homebusinessassistant.local/schemas/agent-manifest-1.0.json",
  "title": "Home Business Assistant Agent Manifest",
  "type": "object",
  "required": [
    "manifestVersion",
    "id",
    "displayName",
    "description",
    "version",
    "executable",
    "supportedCommands",
    "capabilities",
    "defaultTimeoutSeconds",
    "defaultConcurrencyPolicy",
    "supportsScheduling",
    "supportsManualRun",
    "requiresInteractiveUserSession",
    "configurationSchemaVersion"
  ],
  "properties": {
    "manifestVersion": { "const": "1.0" },
    "id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 64,
      "pattern": "^[a-z0-9](?:[a-z0-9-]*[a-z0-9])?$"
    },
    "displayName": { "type": "string", "minLength": 1, "maxLength": 100 },
    "description": { "type": "string", "minLength": 1, "maxLength": 1000 },
    "version": {
      "type": "string",
      "maxLength": 128,
      "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)(?:-[0-9A-Za-z-]+(?:\\.[0-9A-Za-z-]+)*)?(?:\\+[0-9A-Za-z-]+(?:\\.[0-9A-Za-z-]+)*)?$"
    },
    "executable": { "type": "string", "minLength": 1, "maxLength": 512 },
    "supportedCommands": {
      "type": "array",
      "minItems": 1,
      "maxItems": 64,
      "uniqueItems": true,
      "items": { "$ref": "#/$defs/contractName" }
    },
    "capabilities": {
      "type": "array",
      "maxItems": 64,
      "uniqueItems": true,
      "items": { "$ref": "#/$defs/contractName" }
    },
    "defaultTimeoutSeconds": { "type": "integer", "minimum": 1, "maximum": 86400 },
    "defaultConcurrencyPolicy": { "enum": ["Forbid", "QueueOne", "AllowParallel"] },
    "supportsScheduling": { "type": "boolean" },
    "supportsManualRun": { "type": "boolean" },
    "requiresInteractiveUserSession": { "type": "boolean" },
    "configurationSchemaVersion": {
      "type": "string",
      "pattern": "^[1-9][0-9]{0,2}\\.(0|[1-9][0-9]{0,2})$"
    }
  },
  "$defs": {
    "contractName": {
      "type": "string",
      "minLength": 1,
      "maxLength": 64,
      "pattern": "^[A-Za-z0-9](?:[A-Za-z0-9._-]*[A-Za-z0-9])?$"
    }
  },
  "additionalProperties": true
}
